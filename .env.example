# ---------- Required ----------
# Public HTTPS address of the CRM (Meta webhooks require HTTPS)
PUBLIC_URL=https://crm.yourdomain.com
DOMAIN=crm.yourdomain.com
# PostgreSQL connection (Railway/Neon/Supabase give you this). docker-compose builds it from POSTGRES_PASSWORD.
DATABASE_URL=postgres://user:password@host:5432/k3crm
DATABASE_SSL=false
POSTGRES_PASSWORD=change-me-strong-password
# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Encrypts WhatsApp tokens at rest — never change it after go-live
ENCRYPTION_KEY=
# First platform (K3 Solutions) admin — created on first start if none exists
SUPER_ADMIN_EMAIL=you@k3solutions.in
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=K3 Solutions
NODE_ENV=production
# Number of reverse proxies in front of the app (Railway, Render, Caddy, Hostinger = 1; direct to the internet = 0). Needed so login lockouts and the audit log see the real client IP.
TRUST_PROXY=1
# Leave 'false'. Only set 'true' to temporarily re-allow inline scripts if a third-party widget breaks under the stricter Content-Security-Policy.
CSP_ALLOW_INLINE=false
# The server refuses to start on a public deployment (NODE_ENV=production / https PUBLIC_URL / Railway) with missing or default JWT_SECRET / ENCRYPTION_KEY.

# ---------- Meta (optional platform-level defaults) ----------
# Only needed if institutions share ONE Meta app with a global webhook at /webhooks/whatsapp
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# ---------- Optional ----------
# Enables GET /cron/run (needed on Hostinger Business/Cloud, where background timers sleep). Send it as the header  x-cron-key: <CRON_SECRET>  (the ?key= form still works but is logged by proxies)
CRON_SECRET=
# ---------- AI lead ranking ----------
# rules (default: built-in scoring, no external calls) | ollama (self-hosted open-source model — free) | huggingface (free tier, open models) | anthropic
# The rules engine always produces the score; a model only adds a read of what the parent wrote (hot/warm/cold) that nudges the intent factor.
# Phone numbers and e-mail addresses are masked before any text is sent to a model. Each school can switch the model off in AI Qualifier settings.
AI_PROVIDER=rules
# Ollama:  ollama pull qwen2.5:3b   (runs on a small VPS / your own machine)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Hugging Face Inference Providers (free tier): create a token at huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Anthropic (paid):
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=12000
DEFAULT_COUNTRY_CODE=91
UPLOAD_DIR=/data/uploads
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
SEND_RATE_PER_TICK=40
PORT=8080

# ---------- Scaling & reliability ----------
# Live updates across several app servers (needs a direct DB connection, not a transaction pooler)
EVENTS_BACKPLANE=local
# File storage: db (default: disk cache + copy in PostgreSQL) or s3 (AWS S3 / Cloudflare R2 / MinIO / DO Spaces)
STORAGE_DRIVER=db
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Retries for temporary WhatsApp errors (rate limits / Meta outages): 30s, 1m, 2m, 4m… up to 30 min
RETRY_MAX_ATTEMPTS=6
RETRY_BASE_MS=30000
RETRY_MAX_DELAY_MS=1800000
# WhatsApp media IDs expire after 30 days — files are re-uploaded after this many days
WA_MEDIA_TTL_DAYS=25

# ---------- Razorpay billing (institutions subscribe / buy a licence in Settings → Plan & billing) ----------
# Dashboard → Account & Settings → API keys. Webhook: <PUBLIC_URL>/webhooks/razorpay with events
# subscription.* , payment.captured , order.paid  — use the same secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Days of access kept after a failed renewal before the CRM locks (billing screen always stays open)
BILLING_GRACE_DAYS=5

# ---------- WhatsApp one-click signup (Meta Embedded Signup — requires Meta Tech Provider approval) ----------
# META_APP_ID / META_APP_SECRET above + the Embedded Signup configuration ID from Facebook Login for Business
META_ES_CONFIG_ID=
META_ES_SOLUTION_ID=

# ---------- Automated backups (daily gzip snapshot of the whole database) ----------
BACKUP_ENABLED=true
# 21 UTC = 02:30 IST
BACKUP_HOUR_UTC=21
BACKUP_KEEP_DAYS=14
BACKUP_INCLUDE_MEDIA=true
# Where to keep them: an S3/R2 bucket (recommended) — defaults to S3_BUCKET when STORAGE_DRIVER=s3 — else BACKUP_DIR on disk
BACKUP_S3_BUCKET=
BACKUP_DIR=./backups
