# Hostinger Business / Cloud (Node.js Web App) — fill in, then use "Import .env" in hPanel
NODE_ENV=production
PUBLIC_URL=https://crm.yourdomain.com
# External PostgreSQL (Neon / Supabase) — paste the connection string, keep DATABASE_SSL=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
DB_POOL_MAX=5
# Long random strings (generate at https://www.random.org/strings or with openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=
# Secret for the every-minute cron job that runs sequences & broadcasts
CRON_SECRET=
# Your first K3 platform admin login (created on first start)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=K3 Solutions
# Forgot the password? set to true, redeploy, sign in, then set back to false
SUPER_ADMIN_RESET=false
DEFAULT_COUNTRY_CODE=91
# Optional: store files in Cloudflare R2 / AWS S3 instead of the database
STORAGE_DRIVER=db
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Razorpay billing (institutions subscribe / buy a licence in Settings → Plan & billing) ----------
# Dashboard → Account & Settings → API keys. Webhook: <PUBLIC_URL>/webhooks/razorpay with events
# subscription.* , payment.captured , order.paid  — use the same secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Days of access kept after a failed renewal before the CRM locks (billing screen always stays open)
BILLING_GRACE_DAYS=5

# ---------- WhatsApp one-click signup (Meta Embedded Signup — requires Meta Tech Provider approval) ----------
# Your Meta app + the Embedded Signup configuration ID from Facebook Login for Business
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_ES_SOLUTION_ID=

# ---------- Automated backups (daily gzip snapshot of the whole database) ----------
BACKUP_ENABLED=true
# 21 UTC = 02:30 IST
BACKUP_HOUR_UTC=21
BACKUP_KEEP_DAYS=14
BACKUP_INCLUDE_MEDIA=true
# Where to keep them: an S3/R2 bucket (recommended) — defaults to S3_BUCKET when STORAGE_DRIVER=s3 — else BACKUP_DIR on disk
BACKUP_S3_BUCKET=
# Shared hosting disks are not a safe backup location — set BACKUP_S3_BUCKET (Cloudflare R2 is cheap) and the S3_* keys above
BACKUP_DIR=./backups
